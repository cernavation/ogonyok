# ════════════════════════════════════════════════════════════════════════════
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ОГОНЬКА (.env.local)
# Скопируйте этот файл в .env.local и заполните свои значения
# ════════════════════════════════════════════════════════════════════════════

# 1. Supabase (База данных, Авторизация, Realtime, Хранилище)
# Получите в панели: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Gemini API (ИИ-оценка гордостей и благодарностей)
# Получите бесплатный ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# 3. Telegram Bot (Напоминания о дневнике)
# Создайте бота через @BotFather в Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=@OgonekDiaryBot
# (Опционально) Chat ID по умолчанию для тестовых сообщений
TELEGRAM_CHAT_ID=

# 4. Секретный ключ для планировщика напоминаний (Vercel Cron)
# Любая случайная строка, например: openssl rand -hex 16
CRON_SECRET=ogonek_cron_secret_random_hex_key
