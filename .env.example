# ==============================================================================
# ОГОНЁК (.env.example) — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# Скопируйте этот файл в .env.local (для локальной разработки)
# или .env.staging.local (для staging-среды).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (База данных, Аутентификация, Realtime, Storage)
# Где брать: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
# URL инстанса Supabase: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Публичный анонимный ключ: Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Альтернативный алиас для anon key (используется некоторыми клиентами)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Сервисный ключ (SECRET, НИКОГДА НЕ ПЕРЕДАВАТЬ НА КЛИЕНТ!):
# Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. ИИ-ПРОВАЙДЕРЫ (Gemini & DeepSeek)
# Где брать:
# Gemini: https://aistudio.google.com/app/apikey
# DeepSeek: https://platform.deepseek.com/api_keys
# ------------------------------------------------------------------------------
# Ключ Google AI Studio для оценки дней, транскрибации и перевода
GEMINI_API_KEY=AIzaSy...

# Модель Gemini по умолчанию (gemini-2.5-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Ключ DeepSeek для автоматического фоллбека при сбое/исчерпании квоты Gemini
DEEPSEEK_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Уведомления, связка аккаунтов, бот-напоминания)
# Где брать: в Telegram у официального @BotFather
# ------------------------------------------------------------------------------
# Токен бота от @BotFather (формат: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Юзернейм бота (без символа @)
TELEGRAM_BOT_USERNAME=ogonyok_bot

# Секрет для защиты эндпоинтов cron (/api/telegram/cron, /api/cron/deliver-scheduled)
# Сгенерировать произвольную случайную строку: openssl rand -hex 24
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. GIPHY (Поиск и отправка GIF в мессенджере)
# Где брать: https://developers.giphy.com/dashboard/ -> Create an App -> API
# ------------------------------------------------------------------------------
GIPHY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. WEBRTC / TURN СЕРВЕРЫ (Звонки через фаерволы и NAT)
# Где брать: https://www.metered.ca/ -> Dashboard -> TURN Servers
# ------------------------------------------------------------------------------
TURN_URL=turn:standard.relay.metered.ca:80
TURN_USERNAME=xxxxxxxxxxxxxxxx
TURN_PASSWORD=xxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. МОДЕРАЦИЯ И ВЕРИФИКАЦИЯ (Email / Webhook)
# Где брать: Resend https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MODERATION_INBOX=moderators@ogonek.app
MODERATION_FROM=system@ogonek.app
MODERATION_WEBHOOK_URL=https://your-domain.com/api/achievements/moderate-webhook

# ------------------------------------------------------------------------------
# 7. ФЛАГИ ПРИЛОЖЕНИЯ (Опционально)
# ------------------------------------------------------------------------------
# Принудительный запуск в демо-режиме ('true' / 'false')
NEXT_PUBLIC_DEMO_MODE=false

# Автосинхронизация с Supabase ('true' / 'false')
NEXT_PUBLIC_SUPABASE_AUTO_SYNC=true

# Интервал автосинхронизации в миллисекундах (по умолчанию 30000 = 30 сек)
NEXT_PUBLIC_SUPABASE_AUTO_SYNC_MS=30000
