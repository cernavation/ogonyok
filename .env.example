# ==============================================================================
# ОГОНЁК — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# Скопируйте этот файл в .env.local и заполните секретные ключи.
# ВНИМАНИЕ: Секреты используются ТОЛЬКО на сервере.
# Запрещено использовать префикс NEXT_PUBLIC_ для приватных токенов.
# ==============================================================================

# Google Gemini API (для AI-оценщика гордостей)
# Получить ключ: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6JZzJY-03ad7I3FPOzIoJvBfcGepgg8JLyXTa4nQVNV0Q
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot (для синхронизации стрика и отправки ультиматумов)
# Создать бота: @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для запуска периодических напоминаний (GET /api/telegram/remind)
# Используется в заголовке Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ==============================================================================
# ЭТАП 6 — Модерация ачивок: доставка заявок с доказательствами (POST /api/achievements/verify)
# ==============================================================================

# Вариант 1 — Webhook (Slack / Discord / Zapier / n8n). Если задан — имеет приоритет.
MODERATION_WEBHOOK_URL=

# Вариант 2 — Email через Resend (https://resend.com). Отправляет письмо с вложениями.
RESEND_API_KEY=

# Адрес модератора и отправителя писем
MODERATION_INBOX=moderation@ogonyok.app
MODERATION_FROM=verification@ogonyok.app

# Если ни webhook, ни Resend не настроены, заявка складывается в
# .data/moderation-outbox.json со статусом «В очереди».

# ==============================================================================
# ЭТАП 19 — Облачная синхронизация Supabase (offline-first)
# ==============================================================================
# Как включить:
#   1) Выполни SUPABASE_FULL_SCHEMA.sql в Supabase → SQL Editor (создаёт таблицы).
#   2) Вставь Project URL и anon public key из Supabase → Project Settings → API.
#   3) Для бесшовного старта без экрана логина включи
#      Authentication → Providers → Anonymous Sign-Ins.
#
# Пока эти переменные пусты, приложение работает полностью локально
# (ключ хранилища ogonek.v2). Но как только они заданы, клиент
# lib/ogonek/supabase-sync.ts сам включает фоновую синхронизацию:
# изменения копятся офлайн и дозаливаются при появлении сети.
#
# anon public key безопасно держать в браузере: доступ ограничен RLS-политиками.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Необязательно: интервал фоновой автосинхронизации в миллисекундах
# (по умолчанию 60000). Укажи число, чтобы переопределить.
# NEXT_PUBLIC_SUPABASE_AUTO_SYNC_MS=60000
