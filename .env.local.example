# ════════════════════════════════════════════════════════════════════════════
#  ОГОНЁК · ПРИМЕР ЛОКАЛЬНЫХ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ  (ЭТАП 19)
# ────────────────────────────────────────────────────────────────────────────
#  Скопируй этот файл в .env.local и подставь значения из своего проекта
#  Supabase (Project Settings → API). После этого приложение автоматически
#  включит offline-first синхронизацию через lib/ogonek/supabase-sync.ts.
#
#    cp .env.local.example .env.local
#
#  Схему таблиц (profiles, days, prides, gratitudes, achievements_verifications,
#  stories, friendships, reactions, comments, direct_messages) создаёт файл
#  SUPABASE_FULL_SCHEMA.sql — выполни его один раз в SQL Editor.
# ════════════════════════════════════════════════════════════════════════════

# Project URL — «https://<project-ref>.supabase.co»
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (безопасно держать в браузере; доступ ограничен RLS-политиками)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ────────────────────────────────────────────────────────────────────────────
#  НЕОБЯЗАТЕЛЬНО
# ────────────────────────────────────────────────────────────────────────────
#  По умолчанию клиент входит анонимно (Supabase → Authentication → Providers →
#  включи «Anonymous Sign-Ins»). Если нужен вход по email/паролю — оставь пустым
#  и используй панель «Синхронизация с Supabase» в настройках.
#
# NEXT_PUBLIC_SUPABASE_AUTO_SYNC=false
# Период фоновой автосинхронизации в миллисекундах (по умолчанию 60000):
# NEXT_PUBLIC_SUPABASE_AUTO_SYNC_MS=60000
