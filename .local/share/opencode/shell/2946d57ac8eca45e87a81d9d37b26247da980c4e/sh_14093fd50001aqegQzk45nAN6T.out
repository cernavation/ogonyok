diff --git a/components/ogonek/views/home-view.tsx b/components/ogonek/views/home-view.tsx
index f38b0f0..cd9d036 100644
--- a/components/ogonek/views/home-view.tsx
+++ b/components/ogonek/views/home-view.tsx
@@ -55,9 +55,19 @@ export function HomeView({
   }, [])
 
   const filteredDays = useMemo(() => {
+    // «Для тебя» — показывает ВСЕ дни без исключений
     if (filter === 'Для тебя') {
       return days
     }
+    // «Гордости» — по фактическому наличию гордостей, а не по строковым тегам
+    if (filter === '🔥 Гордости') {
+      return days.filter((d) => d.prides && d.prides.length > 0)
+    }
+    // «Благодарности» — по фактическому наличию благодарностей
+    if (filter === '❤️ Благодарности') {
+      return days.filter((d) => d.gratitudes && d.gratitudes.length > 0)
+    }
+    // Остальные хэштег-табы продолжают фильтроваться по тегам
     return days.filter((d) => d.tags.includes(filter))
   }, [days, filter])
 
diff --git a/lib/ogonek/use-ogonek-store.ts b/lib/ogonek/use-ogonek-store.ts
index 6bc44e9..42da9db 100644
--- a/lib/ogonek/use-ogonek-store.ts
+++ b/lib/ogonek/use-ogonek-store.ts
@@ -212,7 +212,7 @@ export function useOgonekStore() {
         const newDay: Day = {
           id: newId,
           title: payload.prides[0] || payload.gratitudes[0] || 'Запись дня',
-          tags: ['Для тебя', '🔥 Гордости'],
+          tags: ['Для тебя', '🔥 Гордости', '❤️ Благодарности'],
           prides: newPrideEntries,
           gratitudes: payload.gratitudes,
           photos: payload.photo ? [payload.photo] : undefined,
@@ -222,11 +222,11 @@ export function useOgonekStore() {
 
         return {
           ...prev,
-          days: [newDay, ...prev.days].sort((a, b) => {
-            const ta = a.dateISO ? new Date(a.dateISO).getTime() : a.id * 86400000
-            const tb = b.dateISO ? new Date(b.dateISO).getTime() : b.id * 86400000
-            return tb - ta
-          }),
+          // Строго по убыванию даты: свежие дни (в т.ч. 12 октября) всегда сверху
+          days: [newDay, ...prev.days].sort(
+            (a, b) =>
+              new Date(b.dateISO!).getTime() - new Date(a.dateISO!).getTime()
+          ),
           composerDraft: null,
         }
       })
